{
  "name": "@vivideo/core",
  "version": "1.1.1",
  "description": "Shared, typed Vivideo API client with built-in rate limiting, retries, idempotency and secret redaction.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "MIT",
  "homepage": "https://developers.vivideo.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egocen-vivideo/vivideo-toolchain.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/egocen-vivideo/vivideo-toolchain/issues"
  },
  "keywords": [
    "ai-video",
    "api-client",
    "sdk",
    "text-to-video",
    "video-generation",
    "vivideo"
  ]
}
